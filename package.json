{
  "name": "pi-double-confirm-interrupt",
  "version": "0.1.0",
  "description": "Require confirmation before interrupting or exiting an active Pi run",
  "type": "module",
  "license": "MIT",
  "author": "xz-dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xz-dev/pi-double-confirm-interrupt.git"
  },
  "homepage": "https://github.com/xz-dev/pi-double-confirm-interrupt#readme",
  "bugs": {
    "url": "https://github.com/xz-dev/pi-double-confirm-interrupt/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "interrupt",
    "exit",
    "confirmation"
  ],
  "files": [
    "index.ts",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
